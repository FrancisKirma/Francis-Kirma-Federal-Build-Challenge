# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# On Vercel these are set as project environment variables, not from a file.

# Which vision provider to call. One of: openai, anthropic
AI_PROVIDER=anthropic

# Only the key for the selected provider is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Falls back to the provider's default vision model.
AI_MODEL=claude-haiku-4-5
